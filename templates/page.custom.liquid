<style>
  .custom-hero { padding: calc(var(--header-h) + 60px) var(--gutter) var(--s-8); text-align: center; max-width: 72ch; margin: 0 auto; }
  .custom-hero .h1 { font-size: clamp(22px, 2.8vw, 40px); margin-bottom: var(--s-5); }
  .custom-pieces { padding: var(--s-10) 0 var(--s-14); background: var(--cream); }
  .custom-pieces .wrap { display: flex; flex-direction: column; gap: var(--s-14); }
  .custom-piece { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-10); align-items: center; }
  .custom-piece:nth-child(even) { direction: rtl; }
  .custom-piece:nth-child(even) > * { direction: ltr; }
  .custom-piece-media { position: relative; aspect-ratio: 4/5; overflow: hidden; background: var(--stone); }
  .custom-piece-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
  .custom-piece-media:hover img { transform: scale(1.04); }
  .custom-piece-alt { position: absolute; bottom: var(--s-4); right: var(--s-4); width: 38%; aspect-ratio: 1; overflow: hidden; border: 3px solid var(--cream); box-shadow: 0 4px 24px rgba(0,0,0,0.15); }
  .custom-piece-alt img { width: 100%; height: 100%; object-fit: cover; }
  .custom-piece-text { padding: var(--s-4) 0; }
  .custom-piece-text .eyebrow { display: block; margin-bottom: var(--s-4); }
  .custom-piece-text .h2 { margin-bottom: var(--s-5); }
  .custom-piece-tag { display: inline-block; font-family: var(--sans); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bronze); border: 1px solid var(--bronze); padding: 4px 12px; margin-bottom: var(--s-5); }
  .process-section { padding: var(--s-14) 0; }
  .process-head { text-align: center; margin-bottom: var(--s-10); }
  .process-head .h2 { margin-bottom: var(--s-4); }
  .process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6); }
  .process-step { padding: var(--s-6) var(--s-5); border-top: 1px solid var(--sand); }
  .process-step .num { font-family: var(--serif); font-size: 42px; color: var(--sand); line-height: 1; margin-bottom: var(--s-4); }
  .process-step h4 { font-family: var(--serif); font-size: 20px; font-weight: 400; color: var(--ink); margin-bottom: var(--s-3); }
  .process-step p { font-family: var(--sans); font-size: 14px; line-height: 1.7; color: var(--ink-muted); }
  @media (max-width: 768px) { .custom-piece { grid-template-columns: 1fr; } .custom-piece:nth-child(even) { direction: ltr; } .process-steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .process-steps { grid-template-columns: 1fr; } }
</style>

<!-- HERO -->
<section class="custom-hero">
  <span class="eyebrow">Made only for you</span>
  <h1 class="h1">Custom and personalized creations<br>are at the heart of my <span class="italic">work.</span></h1>
  <p class="lede">Each piece is a reflection of the soul and stories of the one who wears it — from the spark of a beautiful stone to the birth of something entirely new.</p>
</section>

