{% assign is_inquire = false %}
{% assign is_soldout = false %}
{% assign rotate180 = false %}
{% assign price_from = false %}
{% assign made_in = '' %}

{% for tag in product.tags %}
  {% if tag == 'inquire-only' %}{% assign is_inquire = true %}{% endif %}
  {% if tag == 'sold-out' %}{% assign is_soldout = true %}{% endif %}
  {% if tag == 'rotate-180' %}{% assign rotate180 = true %}{% endif %}
  {% if tag == 'price-from' %}{% assign price_from = true %}{% endif %}
  {% if tag == 'made-in-italy' %}{% assign made_in = 'Italy' %}{% endif %}
  {% if tag == 'made-in-nyc' %}{% assign made_in = 'New York City' %}{% endif %}
{% endfor %}

<main class="pdp">
  <div class="wrap">
    <div class="pdp-grid">
      <!-- GALLERY -->
      <div class="pdp-gallery">
        {% for image in product.images %}
          <div class="shot">
            <img src="{{ image | image_url: width: 900 }}" alt="{{ product.title }}"
              {% if rotate180 and forloop.index <= 2 %}style="transform:rotate(180deg)"{% endif %}>
          </div>
        {% endfor %}
      </div>

      <!-- INFO -->
      <aside class="pdp-info">
        <div class="breadcrumb">
          <a href="{{ routes.collections_url }}/all">Shop</a> ·
          <a href="{{ routes.collections_url }}/{{ product.type | handleize }}">{{ product.type }}</a>
        </div>

        <h1 class="name">{{ product.title }}</h1>

        <div class="price">
          {% if is_inquire %}Inquire
          {% elsif is_soldout %}Sold Out
          {% elsif price_from %}From {{ product.price | money }}
          {% else %}{{ product.price | money }}
          {% endif %}
        </div>

        <p class="description">{{ product.description }}</p>

        <div class="materials">
          {% if product.metafields.custom.materials %}
            <div>
              <div class="label">Material</div>
              <div class="value">{{ product.metafields.custom.materials }}</div>
            </div>
          {% endif %}
          {% if made_in != '' %}
            <div>
              <div class="label">Made in</div>
              <div class="value">{{ made_in }}</div>
            </div>
          {% endif %}
        </div>

        <div class="pdp-actions">
  {% if is_inquire %}
    <p style="font-family:var(--sans);font-size:13px;line-height:1.7;color:var(--ink-muted);margin-bottom:var(--s-4);">Whether it’s a ring, a pair of studs, or a tennis bracelet, we’ll work together to source the right diamonds for your piece — guided by the 4Cs (cut, color, clarity, carat) — to find what meets your requirements.</p>
    <a href="/pages/contact?inquire={{ product.handle }}" class="btn btn-frame">Inquire about this piece</a>
  {% elsif is_soldout %}
    <button class="btn btn-frame" disabled style="opacity:0.5;cursor:default;">Sold Out</button>
  {% else %}
    {% if product.variants.size > 1 %}
      <div style="margin-bottom:var(--s-4);">
        <label style="font-family:var(--sans);font-size:11px;letter-spacing:0.1em;text-transform:uppercase;display:block;margin-bottom:8px;">Size</label>
        <select id="variant-select" style="font-family:var(--sans);font-size:13px;border:1px solid var(--sand);padding:10px 14px;width:100%;background:transparent;cursor:pointer;">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
              {{ variant.title }} — {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      </div>
    {% endif %}
    <button type="button" class="btn btn-frame" id="add-to-cart-btn"
      data-add-to-cart="{{ product.selected_or_first_available_variant.id }}">
      Add to cart — {{ product.selected_or_first_available_variant.price | money }}
    </button>
    <script>
      (function() {
        var sel = document.getElementById('variant-select');
        var btn = document.getElementById('add-to-cart-btn');
        if (sel && btn) {
          sel.addEventListener('change', function() {
            btn.setAttribute('data-add-to-cart', sel.value);
          });
        }
      })();
    </script>
    <p style="font-family:var(--sans);font-size:12px;color:var(--ink-muted);margin-top:var(--s-3);text-align:center;">Ships in 5–7 business days</p>
  {% endif %}
  <a href="/pages/contact?ask={{ product.handle }}" class="btn-link" style="text-align:center;padding-top:8px;">Ask a question about this piece</a>
</div>
      </aside>
    </div>
  </div>
</main>

<!-- RELATED -->
<section class="pdp-related">
  <div class="wrap">
    <h3 class="h3">You might also like</h3>
    <div class="product-grid">
      {% assign related_count = 0 %}
      {% for p in collections.all.products %}
        {% if p.handle != product.handle and p.type == product.type and related_count < 3 %}
          {% render 'product-card', product: p %}
          {% assign related_count = related_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      {% if related_count == 0 %}
        {% for p in collections.all.products %}
          {% if p.handle != product.handle and related_count < 3 %}
            {% render 'product-card', product: p %}
            {% assign related_count = related_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>
