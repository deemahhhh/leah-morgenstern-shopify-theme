<section class="page-hero">
  <div class="page-hero-inner reveal">
    <span class="eyebrow">Get in touch</span>
    <h1 class="h1">Let's start a<br><span class="italic">conversation.</span></h1>
    <p class="lede">Whether you're curious about a piece, interested in a custom commission, or simply want to say hello — I'd love to hear from you.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="contact-grid">
      <div>
        {% form 'contact' %}
          {{ form.errors | default_errors }}
          {% if form.posted_successfully? %}
            <p style="font-family:var(--serif);font-size:22px;color:var(--bronze);line-height:1.5;">
              Thank you — I'll be in touch soon.
            </p>
          {% else %}
            <div class="contact-form">
              <div class="field-row">
                <div class="field">
                  <label for="contact-name">Name</label>
                  <input type="text" id="contact-name" name="contact[name]" placeholder="Your name" required>
                </div>
                <div class="field">
                  <label for="contact-email">Email</label>
                  <input type="email" id="contact-email" name="contact[email]" placeholder="your@email.com" required>
                </div>
              </div>
              <div class="field">
                <label for="contact-subject">Subject</label>
                <input type="text" id="contact-subject" name="contact[subject]" placeholder="What's on your mind?">
              </div>
              <div class="field">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="contact[body]" placeholder="Tell me more..." rows="6" required></textarea>
              </div>
              <button type="submit" class="btn btn-frame">Send message</button>
            </div>
          {% endif %}
        {% endform %}
      </div>

      <div class="contact-info">
        <div class="contact-info-block">
          <span class="eyebrow">Email</span>
          <a href="mailto:hi@leahmorgenstern.com">hi@leahmorgenstern.com</a>
        </div>
        <div class="contact-info-block">
          <span class="eyebrow">Instagram</span>
          <a href="https://www.instagram.com/lm.finejewelry/" target="_blank" rel="noopener">@lm.finejewelry</a>
        </div>
        <div class="contact-info-block">
          <span class="eyebrow">Based in</span>
          <p>New York City</p>
        </div>
        <div class="contact-info-block">
          <span class="eyebrow">Response time</span>
          <p>Usually within 24 hours</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% section 'newsletter' %}
