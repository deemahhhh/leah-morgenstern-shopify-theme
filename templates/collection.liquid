<!-- PAGE HERO -->
<section class="page-hero">
  <div class="page-hero-inner reveal">
    <span class="eyebrow">The Collection</span>
    <h1 class="h1">Quiet objects,<br>made to be <span class="italic">lived in.</span></h1>
    <p class="lede">Each piece is set in gold and platinum, with diamonds and gemstones chosen for their beauty and their energy.</p>
  </div>
</section>

<!-- FILTERS -->
<div class="collection-filters">
  <div class="wrap">
    <div class="filters reveal" role="tablist">
      <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button class="filter-tab" data-filter="Necklaces" role="tab">Necklaces</button>
      <button class="filter-tab" data-filter="Bracelets" role="tab">Bracelets</button>
      <button class="filter-tab" data-filter="Earrings" role="tab">Earrings</button>
      <button class="filter-tab" data-filter="Rings" role="tab">Rings</button>
      <button class="filter-tab" data-filter="Custom" role="tab">Custom</button>
    </div>
    <div class="shop-results-count" id="results-count"></div>
  </div>
</div>

<!-- PRODUCT GRID -->
<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="product-grid" id="shop-grid">
      {% assign priority_handles = "classic-diamond-studs,tennis-necklace,tennis-bracelet,path-ring,tanzanite-custom-earrings" | split: "," %}
      {% for handle in priority_handles %}
        {% assign featured = collection.products | where: "handle", handle | first %}
        {% if featured %}
          <div class="product-grid-item" data-type="{{ featured.type }}">
            {% render 'product-card', product: featured %}
          </div>
        {% endif %}
      {% endfor %}
      {% for product in collection.products %}
        {% unless priority_handles contains product.handle %}
          <div class="product-grid-item" data-type="{{ product.type }}">
            {% render 'product-card', product: product %}
          </div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>


<script>
(function() {
  var tabs = document.querySelectorAll('.filter-tab');
  var items = document.querySelectorAll('.product-grid-item');

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var filter = tab.getAttribute('data-filter');

      // Update active tab
      tabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');

      // Show/hide products
      items.forEach(function(item) {
        if (filter === 'all') {
          item.style.display = '';
        } else {
          item.style.display = (item.getAttribute('data-type') === filter) ? '' : 'none';
        }
      });
    });
  });
})();
</script>
<!-- DON'T SEE IT? -->
<section class="collection-cta">
  <div class="wrap">
    <div class="collection-cta-inner reveal">
      <h2 class="h2">Don't see it?</h2>
      <p class="lede">We do custom work. Tell us what you're envisioning.</p>
      <a href="/pages/contact" class="btn">Get in touch</a>
    </div>
  </div>
</section>